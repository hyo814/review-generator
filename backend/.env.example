# Anthropic API 키 (필수). https://console.anthropic.com/ 에서 발급
ANTHROPIC_API_KEY=sk-ant-...

# 모델 (선택, 기본값 있음)
CLAUDE_MODEL=claude-sonnet-4-20250514

# 시리즈명 접미사 변환 (선택). "{지역}+접미사" 시리즈명을 언어별 표기로 변환
# 예: KO=투어, EN=Tour, JA=ツアー, ZH=之旅 → 홍대투어 → HongdaeTour / 弘大ツアー / 弘大之旅
# 비워두면 LLM이 일반 음역
SERIES_SUFFIX_KO=
SERIES_SUFFIX_EN=
SERIES_SUFFIX_JA=
SERIES_SUFFIX_ZH=

# DB (SQLite 파일 경로. 절대 경로 또는 상대 경로)
DATABASE_URL=sqlite:///./data/reviews.db

# CORS - 프론트엔드 도메인 (콤마 구분)
# 로컬 개발: Vite 기본 5173
# 프로덕션: 실제 도메인 입력
CORS_ORIGINS=http://localhost:5173,http://localhost
